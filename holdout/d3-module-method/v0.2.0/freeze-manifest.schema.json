{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archsync.dev/schemas/d3/module-method-freeze-manifest/2",
  "title": "D3 module method raw-byte freeze manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "endpoint", "guardian_source_commit", "legacy_review_schemas_rejected", "artifacts", "scientific_claims", "human_acceptance"],
  "properties": {
    "schema": { "const": "d3-module-method-freeze-manifest/2" },
    "version": { "const": "0.2.0" },
    "status": { "const": "proposal-not-accepted" },
    "endpoint": { "const": "direct-module-occurrences-and-deduplicated-module-group-edges" },
    "guardian_source_commit": { "const": "e32ef53eeb07bc8c904b6a1e6a8b897d16def820" },
    "legacy_review_schemas_rejected": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "scientific_claims": {
      "const": { "labels_created": false, "predictions_executed": false, "results_computed": false, "d3_complete": false }
    },
    "human_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hieu", "hoang"],
      "properties": { "hieu": { "type": "null" }, "hoang": { "type": "null" } }
    }
  }
}
