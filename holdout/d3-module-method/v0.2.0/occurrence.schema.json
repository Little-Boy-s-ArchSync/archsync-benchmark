{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archsync.dev/schemas/d3/module-occurrence/2",
  "title": "D3 source-bound module occurrence",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "case_id", "side", "commit", "source_path", "start_line", "start_column", "syntax", "quote", "literal_specifier", "source_git_blob", "source_sha256", "resolved_target_path", "target_git_blob", "target_sha256", "source_group", "target_group", "disposition", "reason", "resolver_evidence_refs", "ai_provenance"],
  "properties": {
    "repository": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "side": { "enum": ["base", "head"] },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "source_path": { "type": "string", "minLength": 1 },
    "start_line": { "type": "integer", "minimum": 1 },
    "start_column": { "type": "integer", "minimum": 1 },
    "syntax": { "enum": ["import", "re-export", "require", "dynamic-import"] },
    "quote": { "type": "string", "minLength": 1 },
    "literal_specifier": { "type": "string", "minLength": 1 },
    "source_git_blob": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resolved_target_path": { "type": ["string", "null"] },
    "target_git_blob": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "target_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "source_group": { "type": ["string", "null"] },
    "target_group": { "type": ["string", "null"] },
    "disposition": { "enum": ["resolved-in-scope", "resolved-out-of-scope", "unresolved-target", "unsupported-syntax-or-resolver", "missing-or-conflicting-source"] },
    "reason": { "type": "string", "minLength": 1 },
    "resolver_evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "ai_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "human_verification"],
      "properties": {
        "used": { "type": "boolean" },
        "tool_model": { "type": ["string", "null"] },
        "input_scope": { "type": ["string", "null"] },
        "input_sha256": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "uniqueItems": true },
        "output_reference": { "type": ["string", "null"] },
        "output_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "shared": { "type": ["boolean", "null"] },
        "human_verification": { "enum": ["full", "sampled", "not-checked"] }
      }
    }
  }
}
