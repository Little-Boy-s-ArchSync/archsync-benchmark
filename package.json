{
  "name": "archsync-benchmark",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "test": "pnpm test:coverage",
    "test:coverage": "node scripts/unit-coverage-evidence.mjs",
    "coverage:update": "node scripts/unit-coverage-evidence.mjs --write",
    "validate:model": "archsync validate order-platform/architecture.yaml",
    "validate:benchmark": "archsync benchmark order-platform/ground-truth.json",
    "validate:vendor": "node scripts/validate-vendor-artifacts.mjs",
    "validate:ground-truth": "node scripts/validate-ground-truth.mjs",
    "validate:docs": "node scripts/validate-documentation.mjs",
    "validate:patches": "node scripts/validate-patches.mjs",
    "validate:patterns": "node scripts/validate-pattern-corpus.mjs",
    "integrity:update": "node scripts/benchmark-integrity.mjs --write",
    "integrity:verify": "node scripts/benchmark-integrity.mjs",
    "phase2:update": "node scripts/phase2-evidence.mjs --write",
    "phase2:verify": "node scripts/phase2-evidence.mjs",
    "phase2:snapshot": "node scripts/validate-phase2-snapshot.mjs",
    "phase3:update": "node scripts/phase3-evidence.mjs --write",
    "phase3:verify": "node scripts/phase3-evidence.mjs",
    "patterns:update": "node scripts/pattern-corpus-evidence.mjs --write",
    "patterns:baseline:verify": "node scripts/validate-pattern-baseline.mjs",
    "patterns:verify": "node scripts/pattern-corpus-evidence.mjs",
    "demo": "node scripts/demo-cli.mjs --scenario all",
    "demo:pass": "node scripts/demo-cli.mjs --scenario pass",
    "demo:block": "node scripts/demo-cli.mjs --scenario block",
    "demo:review": "node scripts/demo-cli.mjs --scenario review",
    "demo:case06": "node scripts/demo-case.mjs case-06",
    "demo:case09": "node scripts/demo-case.mjs case-09",
    "demo:phase3:pass": "node scripts/demo-phase3.mjs case-01",
    "demo:phase3:block": "node scripts/demo-phase3.mjs case-06",
    "demo:phase3:review": "node scripts/demo-phase3.mjs case-09",
    "demo:phase3": "pnpm demo:phase3:pass && pnpm demo:phase3:block && pnpm demo:phase3:review",
    "verify": "pnpm validate:vendor && pnpm validate:model && pnpm validate:benchmark && pnpm validate:ground-truth && pnpm validate:docs && pnpm validate:patches && pnpm validate:patterns && pnpm patterns:baseline:verify && pnpm integrity:verify && pnpm test && pnpm phase2:verify && pnpm phase2:snapshot && pnpm patterns:verify && pnpm phase3:verify"
  },
  "dependencies": {
    "@archsync/core": "file:vendor/archsync-core-0.1.0-2affbbb.tgz",
    "@archsync/guardian": "file:vendor/archsync-guardian-0.3.1-8779bf7.tgz"
  }
}
