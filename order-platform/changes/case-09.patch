diff --git a/order-service/src/cache.ts b/order-service/src/cache.ts
new file mode 100644
--- /dev/null
+++ b/order-service/src/cache.ts
@@ -0,0 +1,13 @@
+import { createClient } from "redis";
+
+const redis = createClient({
+  url: process.env.REDIS_URL ?? "redis://redis:6379",
+});
+
+export async function getCachedOrder(order: unknown): Promise<boolean> {
+  return (await redis.get(JSON.stringify(order))) !== null;
+}
+
+export async function setCachedOrder(order: unknown): Promise<void> {
+  await redis.set(JSON.stringify(order), "1", { EX: 60 });
+}
