    },
    "exclude": {
      "path": "(?:^|/)(?:__tests__|tests?|fixtures|__fixtures__|__mocks__)(?:/|$)|\\.(?:test|spec)\\.[cm]?[jt]sx?$|\\.d\\.[cm]?ts$"
    }
  }
